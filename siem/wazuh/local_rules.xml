<!--
  AlertMind : Wazuh local rules (single group, single file per instructor).

  Two detection sections:
    - Linux (100100+): Wazuh-native form of the auditd detections; fires on the
      keys set by /etc/audit/rules.d/alertmind.rules on linux-victim. Each child
      rule chains off base rule 80700 (level 0) via if_sid, matches one
      audit.key, raises the level, and tags ATT&CK.
    - Windows (100200+): Sysmon detections; each chains off a Wazuh built-in
      Sysmon base rule via if_sid and narrows on Sysmon fields.

  execve (key t1059_exec) is intentionally NOT alerted here: it is high
  volume substrate telemetry for command specific rules, not an alert.

  Deploy + validation steps live in README.md and architecture/soc-architecture.md
  (kept out of this comment to avoid double hyphen sequences, which are illegal
  inside XML comments).
-->

<group name="audit,attack,alertmind,">

  <!-- ============ CREDENTIAL ACCESS ============ -->
  <rule id="100100" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1003_008_shadow_read</field>
    <description>AlertMind: /etc/shadow or /etc/gshadow read - possible credential access (T1003.008)</description>
    <mitre>
      <id>T1003.008</id>
    </mitre>
  </rule>

  <rule id="100113" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1552_004_ssh_keys</field>
    <description>AlertMind: Access to /root/.ssh - SSH private keys / authorized_keys (T1552.004)</description>
    <mitre>
      <id>T1552.004</id>
    </mitre>
  </rule>

  <!-- ============ PERSISTENCE / ACCOUNT MANIPULATION ============ -->
  <rule id="100101" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1136_accounts</field>
    <description>AlertMind: Modification of user/group database (passwd/shadow/group) (T1136 / T1098)</description>
    <mitre>
      <id>T1136</id>
      <id>T1098</id>
    </mitre>
  </rule>

  <rule id="100103" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1053_003_cron</field>
    <description>AlertMind: Cron configuration modified - scheduled-task persistence (T1053.003)</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
  </rule>

  <rule id="100104" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1543_002_systemd</field>
    <description>AlertMind: systemd unit modified - service persistence (T1543.002)</description>
    <mitre>
      <id>T1543.002</id>
    </mitre>
  </rule>

  <rule id="100105" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1037_init</field>
    <description>AlertMind: Boot/logon init script modified (rc.local / init.d) (T1037)</description>
    <mitre>
      <id>T1037</id>
    </mitre>
  </rule>

  <rule id="100106" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1546_004_shell_init</field>
    <description>AlertMind: Shell init file modified (profile / bashrc / environment) (T1546.004)</description>
    <mitre>
      <id>T1546.004</id>
    </mitre>
  </rule>

  <rule id="100107" level="13">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1574_006_ldpreload</field>
    <description>AlertMind: Dynamic linker config modified (ld.so.preload/conf) - LD_PRELOAD hijack (T1574.006)</description>
    <mitre>
      <id>T1574.006</id>
    </mitre>
  </rule>

  <rule id="100108" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1547_006_kmod</field>
    <description>AlertMind: Kernel module load/unload or modprobe config change - possible LKM rootkit (T1547.006 / T1014)</description>
    <mitre>
      <id>T1547.006</id>
      <id>T1014</id>
    </mitre>
  </rule>

  <!-- ============ PRIVILEGE ESCALATION ============ -->
  <rule id="100102" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1548_003_sudoers</field>
    <description>AlertMind: sudoers modified - privilege-escalation persistence (T1548.003)</description>
    <mitre>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <rule id="100109" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1548_001_setuid</field>
    <description>AlertMind: setuid/setgid bit change by user - possible privilege escalation (T1548.001)</description>
    <mitre>
      <id>T1548.001</id>
    </mitre>
  </rule>

  <!-- ============ DEFENSE EVASION ============ -->
  <rule id="100110" level="13">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1562_001_audit_tamper</field>
    <description>AlertMind: auditd configuration tampering - defense evasion (T1562.001)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
  </rule>

  <rule id="100111" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1070_logs</field>
    <description>AlertMind: Login/session log modified (wtmp/btmp/utmp) - indicator removal (T1070)</description>
    <mitre>
      <id>T1070</id>
    </mitre>
  </rule>

  <rule id="100112" level="10">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1070_006_timestomp</field>
    <description>AlertMind: File timestamp modification by user - timestomping (T1070.006)</description>
    <mitre>
      <id>T1070.006</id>
    </mitre>
  </rule>

  <!-- ============ INITIAL ACCESS / CONFIG ============ -->
  <rule id="100114" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1098_sshd_config</field>
    <description>AlertMind: sshd_config modified - SSH daemon access-config change (broad T1098; T1098.004 is authorized_keys, see 100116)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- Precise T1098.004: authorized_keys access under /root/.ssh.
       NOTE: auditd cannot reliably key authorized_keys separately from the broad
       /root/.ssh watch (overlapping watches collapse to one key), so this is a
       CHILD of 100113 that narrows on the file path Wazuh-side rather than a
       direct audit.key match. If audit.file.name does not carry the filename in
       your events, swap the field line for: <match>authorized_keys</match> -->
  <rule id="100116" level="10">
    <if_sid>100113</if_sid>
    <field name="audit.file.name">authorized_keys</field>
    <description>AlertMind: /root/.ssh/authorized_keys accessed/modified - possible SSH authorized-keys persistence (T1098.004)</description>
    <mitre>
      <id>T1098.004</id>
    </mitre>
  </rule>

  <!-- NOTE: mapping is TENTATIVE. Editing APT sources/config is not cleanly
       "Ingress Tool Transfer"; a malicious repo is closer to supply-chain
       compromise (T1195.001). Kept as a low-confidence hygiene monitor. -->
  <rule id="100115" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.key">t1195_001_apt_repo_config</field>
    <description>AlertMind: Package manager / repository configuration changed (low confidence; tentative T1195.001)</description>
    <mitre>
      <id>T1195.001</id>
    </mitre>
  </rule>

  <!--
    Windows Sysmon detections (custom range 100200+; Linux uses 100100+).
    Each rule chains off a Wazuh built-in Sysmon base rule (level 0) via
    if_sid and narrows on Sysmon fields. Base rules: EID 1 = 61603,
    EID 10 = 61612, EID 13 = 61615, EID 22 = 61624.
    Sigma source: detections/sigma/windows/.
  -->

  <!-- ============ INITIAL ACCESS / EXECUTION (Windows) ============ -->
  <!-- Office app spawns a shell/script interpreter (malicious macro pattern) -->
  <rule id="100200" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook|msaccess|mspub)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta)\.exe$</field>
    <description>AlertMind: Office app $(win.eventdata.parentImage) spawned interpreter $(win.eventdata.image) - possible malicious macro (T1566/T1059)</description>
    <mitre>
      <id>T1566</id>
      <id>T1059</id>
    </mitre>
  </rule>

  <!-- ============ EXECUTION ============ -->
  <!-- PowerShell encoded command: -e/-ec/-enc/-encodedcommand (and / variants) followed by a base64 blob -->
  <rule id="100201" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)[-/]e(ncodedcommand|nc|c)?\s+[A-Za-z0-9+/=]{20,}</field>
    <description>AlertMind: PowerShell encoded command executed - possible obfuscated payload (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <!-- LOLBin execution (mshta / regsvr32 / wmic) -->
  <rule id="100202" level="8">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(mshta|regsvr32|wmic)\.exe$</field>
    <description>AlertMind: Living-off-the-land binary $(win.eventdata.image) executed - possible signed-binary proxy execution (T1218)</description>
    <mitre>
      <id>T1218</id>
    </mitre>
  </rule>

  <!-- ============ CREDENTIAL ACCESS ============ -->
  <!-- LSASS process access (credential dumping). Requires Sysmon EID 10 with lsass.exe included.
       Alerts on any GrantedAccess except: 0x1000 / 0x1400 (benign query-only, no VM_READ bit),
       and 0x3000 (PROCESS_QUERY_LIMITED_INFORMATION + PROCESS_SUSPEND_RESUME, no VM_READ bit;
       svchost fires this legitimately).
       Also excludes always-benign sourceImages: wazuh-agent.exe (monitoring agent itself) and
       MsMpEng.exe (Windows Defender AV). Both legitimately open LSASS at high-privilege masks.
       Lab pre-condition: RunAsPPL must be 0 to allow dump-grade handles; with PPL enabled the OS
       blocks the handle and no EID 10 is emitted. Note that in that case Sysmon still logs the
       ATTEMPT, so a denied access is also a valid detection signal.
       In production: expand the sourceImage exclusion to cover other trusted security tools. -->
  <rule id="100203" level="12">
    <if_sid>61612</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(?!(1000|1400|3000)$)[0-9a-f]+$</field>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)^(?!.*\\(wazuh-agent|MsMpEng)\.exe$).*</field>
    <description>AlertMind: LSASS access by $(win.eventdata.sourceImage) (granted $(win.eventdata.grantedAccess)) - possible credential dumping (T1003.001)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- ============ LATERAL MOVEMENT ============ -->
  <!-- PsExec service binary on the target. Catches the default PSEXESVC name; renamed services evade. -->
  <rule id="100204" level="12">
    <if_sid>61603</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\PSEXESVC\.exe$</field>
    <description>AlertMind: PsExec service binary executed - possible remote service execution / lateral movement (T1021.002/T1569.002)</description>
    <mitre>
      <id>T1021.002</id>
      <id>T1569.002</id>
    </mitre>
  </rule>

  <!-- ============ PERSISTENCE ============ -->
  <!-- Registry Run/RunOnce value set (autorun persistence). Chains off Wazuh's
       built-in Run-key parent 92300 (0860-sysmon_id_13.xml), which already matches
       the Run-key path in Wazuh's doubled-backslash registry format. Level 10 so it
       outranks the built-in reg.exe child 92302 (level 6) and is the reported alert.
       The extra targetObject field re-narrows to Run/RunOnce so the rule does NOT
       fire on CurrentVersion\RunNotification (a shell startup-notification key that
       92300 also prefix-matches, observed as a false positive during testing).
       FP note: installers and legitimate software add Run keys. -->
  <rule id="100205" level="10">
    <if_sid>92300</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CURRENTVERSION\\\\RUN(ONCE)?\\\\</field>
    <description>AlertMind: Run/RunOnce registry value set ($(win.eventdata.targetObject)) - autorun persistence (T1547.001)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
  </rule>

  <!-- ============ EXFILTRATION / C2 (heuristic) ============ -->
  <!-- DNS query with an unusually long label - possible DNS tunneling. Heuristic; tune the
       threshold and allowlist known long-subdomain services (CDNs, telemetry). Sysmon EID 22. -->

  <rule id="100206" level="6">
    <if_group>sysmon_event_22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">(?i)^[a-z0-9_-]{45,}\.alertmind-lab\.invalid\.?$</field>
    <description>AlertMind: DNS query with long label ($(win.eventdata.queryName)) - possible DNS tunneling (heuristic; T1048/T1071.004)</description>
    <mitre>
      <id>T1048</id>
      <id>T1071.004</id>
    </mitre>
    <group>alertmind,attack,exfiltration,command_and_control,windows,sysmon,</group>
  </rule>

</group>

# AlertMind assistant — provider configuration.
#
# HOW TO USE: copy this file to `.env` (same folder) and fill in what you need.
#   cp .env.example .env          # macOS/Linux
#   Copy-Item .env.example .env   # PowerShell
# llm.py loads `.env` automatically on import. Variables already set in your
# shell take precedence over this file. `.env` is gitignored — never commit keys.
# The default `mock` provider needs none of these.

# --- Ollama (local, OpenAI-compatible; no key required) ---
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- NVIDIA build.nvidia.com (OpenAI-compatible, GPU-hosted) ---
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_API_KEY=nvapi-xxxxx

# --- OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxx

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# NOTE: OPENAI_BASE_URL is shared by the ollama/openai providers. If you switch
# from Ollama to a hosted endpoint, you MUST update it — a stale
# http://localhost:11434/v1 is the most common cause of hangs/404s.
# Run `python preflight.py --provider openai --model <model>` to verify.

# --- Reliability / performance (optional) ---
# ALERTMIND_LLM_TIMEOUT=300     # per-call seconds; raise for large local models
# ALERTMIND_MAX_TOKENS=1024     # cap response length (also speeds up local models)
# ALERTMIND_LLM_RETRIES=2       # retries on transient errors (429/5xx/connection)
